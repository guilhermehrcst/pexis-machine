{
  "name": "pexis-machine-web-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pexis Machine Web Lab: a browser observer and controller for the C++ simulation core compiled to WebAssembly.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "wasm:build": "bash ../scripts/build-wasm.sh",
    "wasm:check": "node scripts/check-wasm.mjs",
    "dev": "npm run wasm:check && vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run wasm:check && vitest run",
    "build": "npm run wasm:check && npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@radix-ui/react-icons": "1.3.2",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "overrides": {
    "rollup": "4.63.5"
  }
}
